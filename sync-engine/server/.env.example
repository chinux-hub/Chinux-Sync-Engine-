PORT=4000
JWT_SECRET=replace-with-a-long-random-secret

# Choose exactly one backend: postgres | mysql | mongodb
DB_BACKEND=postgres

POSTGRES_URL=postgres://postgres:syncdb@localhost:5432/syncdb
MYSQL_URL=mysql://root:syncdb@localhost:3306/syncdb
MONGO_URL=mongodb://localhost:27017
MONGO_DB=syncdb
